# Use a long, unique value for JWT_SECRET in your local .env file.
JWT_SECRET=replace-with-a-long-random-local-development-secret

# Reserved for a future LLM integration. Do not put real keys in this file.
LLM_API_KEY=

# Gemini API key for LLM-powered intent extraction and persona response generation.
GEMINI_API_KEY=

# Optional test key to preserve quota on the main key during local testing.
GEMINI_API_KEY_TEST=
USE_TEST_KEY=false
